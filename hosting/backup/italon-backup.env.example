# /etc/italon-backup.env — настройки резервного копирования заявок. Права: chmod 600, владелец root.
APP_DIR=/opt/italon-x2
LOCAL_DIR=/var/backups/italon
STATE_DIR=/var/lib/italon-backup
# Открытый ключ age (строка age1…). Закрытый ключ хранит владелец ВНЕ сервера (см. ops/backup.md).
AGE_RECIPIENTS=/etc/italon-backup/recipients.txt
# Хранилище в РФ (rclone remote): Яндекс Object Storage, Selectel, VK Cloud, Яндекс Диск и т.п.  Пример: italon-ru:italon-backups
RCLONE_REMOTE=
REQUIRE_OFFSITE=1
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Кому слать сообщения об ошибках (по умолчанию — первый TELEGRAM_CHAT_ID из /opt/italon-x2/.env)
BACKUP_ALERT_CHAT_ID=
# Необязательно: адрес «пульса» внешнего монитора (healthchecks.io и т.п.). Получает только пустой запрос, без данных.
HC_PING_URL=
