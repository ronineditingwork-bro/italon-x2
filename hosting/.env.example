DOMAIN=italon-x2.ru
TLS_EMAIL=italon@amanagroup.org
# Заявки из КП уходят в Telegram: токен бота от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Несколько получателей — id через запятую: TELEGRAM_CHAT_ID=111111111,222222222
# Если сервер не достаёт до api.telegram.org — адрес ретранслятора (см. hosting/telegram-relay-worker.js)
TELEGRAM_API_BASE=
# Необязательно: общий секрет с ретранслятором (в Cloudflare Worker задать переменную RELAY_KEY с тем же значением)
TELEGRAM_RELAY_KEY=
# 152-ФЗ: включать ТОЛЬКО после проверки юристом текстов политики и согласия (см. ops/legal/README.md)
REQUIRE_CONSENT=0
CONSENT_VERSION=
